{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/comics-sourcehub/source.schema.json",
  "title": "Comics SourceHub catalogue",
  "type": "object",
  "required": ["schemaVersion", "category", "sources"],
  "properties": {
    "schemaVersion": {"const": 1},
    "category": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/source"},
          {"$ref": "#/$defs/reference"}
        ]
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["id", "refFile", "refId"],
      "properties": {
        "id": {"type": "string"},
        "refFile": {"type": "string"},
        "refId": {"type": "string"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "name", "siteUrl", "language", "contentTypes", "sourceKind", "integration", "parser"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "name": {"type": "string", "minLength": 1},
        "siteUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "language": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "contentTypes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "sourceKind": {"type": "string"},
        "integration": {"type": "string"},
        "parser": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/parser"}]},
        "apiRepository": {"type": "string", "format": "uri"},
        "apiStatus": {"type": "string"},
        "antiBot": {"type": "array", "items": {"type": "string"}},
        "requiresBrowserFallback": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "parser": {
      "type": "object",
      "required": ["sourceId", "repo", "filePath", "parserChecked"],
      "properties": {
        "sourceId": {"type": "string"},
        "repo": {"type": "string", "format": "uri"},
        "filePath": {"type": "string"},
        "parserChecked": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
